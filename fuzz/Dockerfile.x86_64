FROM --platform=linux/amd64 rust:latest

RUN cargo install cargo-fuzz --locked

# cargo-fuzz's `-Z` flags on the repo's pinned stable toolchain; no nightly.
ENV RUSTC_BOOTSTRAP=1

WORKDIR /seqair
COPY . .

# Pre-build fuzz targets
# Note: for fuzz_reader_indexed (tmpfile-based), run with --tmpfs /tmp for speed:
#   docker run --tmpfs /tmp --platform linux/amd64 seqair-fuzz-x86 "..."
RUN cargo fuzz build

ENTRYPOINT ["bash", "-c"]
CMD ["cargo fuzz list"]
